{$DOMAIN} {
  encode zstd gzip
  request_body {
    max_size 8MB
  }
  handle_path /api/* {
    reverse_proxy backend:3000
  }
  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy same-origin
    X-Frame-Options DENY
  }
}
