# Application settings: frontend origin, HTTP port, and runtime environment.
# In production, the frontend origin must use HTTPS and refresh cookies are Secure.
FRONTEND_ORIGIN=http://localhost:4200
PORT=3000
NODE_ENV=development

# PostgreSQL connection settings for local development; the port matches Docker Compose.
DB_NAME=messenger-db
DB_USER=messenger-user
DB_PASSWORD=secret
DB_HOST=localhost
DB_PORT=6012

# JWT and session settings. Generate a signing secret with: openssl rand -hex 32
# Access token TTL is in seconds (15 minutes); session TTL is in milliseconds (7 days).
# Both TTLs must be positive integers. Refreshing tokens does not extend the session.
JWT_SECRET=secret
JWT_ACCESS_TOKEN_TTL=900
JWT_SESSION_TTL=604800000

# Cookie URL path: /auth locally, /api/auth behind the production reverse proxy.
AUTH_COOKIE_PATH=/auth

# Private object storage. On EC2 use an instance IAM role, without static AWS keys.
S3_BUCKET=your-unique-messenger-bucket
S3_REGION=eu-central-1
# Lifetime of avatar links, seconds; 1–3600.
S3_SIGNED_URL_TTL_SECONDS=900
# Optional S3-compatible endpoint for local development; leave empty for AWS S3.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Local credentials may be supplied through the standard AWS SDK provider chain:
# AWS_PROFILE=your-profile
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
