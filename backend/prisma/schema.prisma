generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  username     String    @unique
  displayName  String
  passwordHash String
  // TODO: avatar
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime? @db.Timestamptz(3)

  sessions        UserSession[]
  chatMemberships ChatMember[]
  messages        Message[]
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
}

model Chat {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  members  ChatMember[]
  messages Message[]
}

model ChatMember {
  chatId    String    @db.Uuid
  userId    String    @db.Uuid
  joinedAt  DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([chatId, userId])
  @@index([userId])
}

model Message {
  id        String    @id @default(uuid()) @db.Uuid
  chatId    String    @db.Uuid
  senderId  String    @db.Uuid
  text      String
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  editedAt  DateTime? @db.Timestamptz(3)
  readAt    DateTime? @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Restrict)
  sender User @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([chatId, createdAt, id])
  @@index([senderId])
}
