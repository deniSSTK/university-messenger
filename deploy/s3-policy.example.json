{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MessengerMediaOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::YOUR_BUCKET/attachments/*",
        "arn:aws:s3:::YOUR_BUCKET/avatars/*"
      ]
    }
  ]
}
