# Copy to .env.production and supply your own domain, database password and signing secret.
# Use a free DuckDNS hostname or <PUBLIC_IP>.sslip.io; no purchased domain is required.
DOMAIN=your-project.duckdns.org
DB_NAME=messenger
DB_USER=messenger
DB_PASSWORD=replace-with-a-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TOKEN_TTL=900
JWT_SESSION_TTL=604800000

# For compose.aws.yml: copy the lowercase image paths and commit tag from GitHub Actions.
BACKEND_IMAGE=ghcr.io/your-github-user/university-messenger-backend:replace-with-commit-sha
FRONTEND_IMAGE=ghcr.io/your-github-user/university-messenger-web:replace-with-commit-sha

# Private object storage. On EC2 use an instance IAM role, without static AWS keys.
S3_BUCKET=your-unique-messenger-bucket
S3_REGION=eu-central-1
# Lifetime of avatar links, seconds; 1–3600.
S3_SIGNED_URL_TTL_SECONDS=900
# Optional S3-compatible endpoint for local development; leave empty for AWS S3.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Local credentials may be supplied through the standard AWS SDK provider chain:
# AWS_PROFILE=your-profile
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
